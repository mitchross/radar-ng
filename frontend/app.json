{
  "expo": {
    "name": "radar-ng",
    "slug": "radar-ng",
    "version": "2.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "radarng",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.vanillax.radar-ng",
      "buildNumber": "7",
      "appleTeamId": "FVU6RGL532",
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.vanillax.radar-ng"]
      },
      "infoPlist": {
        "CFBundleDisplayName": "Radar NG",
        "NSLocalNetworkUsageDescription": "Radar NG connects to a weather server on your local network when you configure one."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081A24",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.vanillax.radarng",
      "versionCode": 7
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081A24",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/withCarPlayScene",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Radar NG uses your location to show radar, forecasts and alerts for where you are.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ],
      "./plugins/withXcode27PodDeploymentFloor",
      "./plugins/withScriptSandboxOff",
      "./plugins/withAndroidAppLabel",
      "./plugins/withAndroidNetworkSecurity",
      "./plugins/withAndroidReleaseSigning",
      "@bacons/apple-targets",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
            "node_modules/@expo-google-fonts/newsreader/400Regular_Italic/Newsreader_400Regular_Italic.ttf",
            "node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
            "node_modules/@expo-google-fonts/spline-sans/400Regular/SplineSans_400Regular.ttf",
            "node_modules/@expo-google-fonts/spline-sans/500Medium/SplineSans_500Medium.ttf",
            "node_modules/@expo-google-fonts/spline-sans/600SemiBold/SplineSans_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/spline-sans/700Bold/SplineSans_700Bold.ttf"
          ]
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
