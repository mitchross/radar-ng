# Release builds from this repo use the shared VersaTiles map server as the basemap.
# Delete a line to fall back to the bundled Protomaps style for that theme (docs/configuration.md).
EXPO_PUBLIC_BASEMAP_LIGHT_STYLE_URL=https://maps.vanillax.me/styles/light.json
EXPO_PUBLIC_BASEMAP_DARK_STYLE_URL=https://maps.vanillax.me/styles/dark.json
