{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink session-stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink pre-read"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink pre-write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink pre-write"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink post-read"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink post-write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink post-write"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink post-tool"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "command -v mink >/dev/null 2>&1 || exit 0; mink post-tool"
          }
        ]
      }
    ]
  }
}
