# cross-cutting

# Build outputs: IPAs, xcarchives, APKs/AABs, Xcode Organizer exports.
# Native folders (frontend/ios, frontend/android) are generated and disposable.
/artifacts/

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# OpenWolf capture scratch
.wolf/designqc-captures/

# Reference material (not source)
UI-Handoff/
*.zip

# Python (fixture generators under rust/crates/*/testdata, frontend/scripts)
__pycache__/
*.pyc
.venv/

# Editor
.vscode/.history/
.idea/
*.swp

# Node / JS
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo

# Expo / React Native
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Generated native projects (managed Expo prebuild)
/ios
/android
.kotlin/

# iOS build artifacts (if native dirs are ever committed)
**/Pods/
**/build/
**/DerivedData/
**/xcuserdata/
*.xcuserstate
xcodebuild*.log

# Xcode Organizer export folders: "<scheme> YYYY-MM-DD HH-MM-SS/"
# They carry signed IPAs and provisioning profiles, so keep them out of git.
*.ipa
*.xcarchive
**/DistributionSummary.plist
**/ExportOptions.plist

# Native signing material
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# EAS / Expo local
.eas/
eas.local.json

# Logs
*.log
logs/

# Personal agent instructions and settings (never committed)
CLAUDE.local.md
AGENTS.local.md
.claude/settings.local.json
