# Shared by level2-api, the publisher and the recorder. Every gate is false: flip them in your
# overlay for the shadow run only. Public Level II stays off until D1 is decided.
# The pilot list is explicit on purpose: never rely on the code's KGRR default.
# <<< D3 pilot list: 3-5 ids, each in catalogue::FEED_VERIFIED (KGRR, KDTX, KLOT, KAPX, KTLX, KFFC, KATX today).
LEVEL2_ENABLED_STATIONS=KGRR,KDTX
LEVEL2_VIEWPORT_ENABLED=false
LEVEL2_TILE_ENABLED=false
LEVEL2_SHADOW_ENABLED=false
LEVEL2_OBJECT_PREFIX=level2/pool
LEVEL2_PG_SCHEMA=level2_numeric
# The recorder talks to level2-api in-cluster; set EDGE_URL to the shadow hostname to measure the edge.
LEVEL2_SHADOW_API_URL=http://level2-api.radar-ng.svc.cluster.local:8080
LEVEL2_SHADOW_EDGE_URL=http://level2-api.radar-ng.svc.cluster.local:8080
LEVEL2_SHADOW_COLD_EVERY_S=1800
# <<< your Prometheus, for the daily peak RSS / CPU capture. Empty skips it.
LEVEL2_SHADOW_PROM_URL=
LEVEL2_SHADOW_PROM_NAMESPACE=radar-ng
# Test drill only: hides NOAA objects newer than N seconds. 0 is off; never set it in the pilot.
LEVEL2_TEST_FEED_DELAY_S=0
