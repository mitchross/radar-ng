# radar-ng settings shared by the api (tile-server) and the workers.
# Changing a value here rolls the pods that read it (Kustomize hashes the ConfigMap name).

# >>> CHANGE THIS <<<  api.weather.gov wants a contact in the User-Agent. Use your own email.
NWS_USER_AGENT=(radar-ng, you@example.com)

# Temporal frontend (host:port) and namespace. The default matches components/temporal-dev.
# With your own Temporal: e.g. temporal-frontend.temporal.svc.cluster.local:7233
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Queue layout. Base runs one `legacy` worker on queue `radar-ng`, so the api must start storm
# watches there. components/worker-controller flips these to 1 / radar-ng-alerts (role pools).
USE_ISOLATED_TASK_QUEUES=0
TEMPORAL_ALERTS_TASK_QUEUE=radar-ng
