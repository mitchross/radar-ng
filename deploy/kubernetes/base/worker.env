# Worker tunables. Every key is optional; see docs/self-host/configuration.md and tuning.md.
# Values match the production cluster except where noted.
PALETTES=classic,muted,vivid
# MRMS frames back-filled per schedule fire (every minute).
BACKLOG_PER_CYCLE=1
MRMS_PREFIX=CONUS/MergedBaseReflectivityQC_00.50
FORECAST_HOURS=18
EXTENDED_FORECAST_HOURS=48
# HRRR secondary layers. Drop entries to save CPU; radar-hrrr is the important one.
HRRR_ENABLED_LAYERS=radar-hrrr,wind,temperature,feels-like,dewpoint,precip-accum,cloud
MRMS_QPE_24H_ENABLED=1
NOWCAST_HORIZON_MIN=60
NOWCAST_STEP_MIN=5
NOWCAST_INPUT_FRAMES=4
NOWCAST_GRID_INPUT_LAYER=radar-nowcast-input
NOWCAST_SCIENCE_GRID_MAX_CELLS=7000000
NOWCAST_MAX_INPUT_GAP_MIN=6
NOWCAST_ALLOW_PERSISTENCE_FALLBACK=0
INTENSIFY_DBZ_DELTA=10
DISSIPATE_DBZ_DELTA=10
HAIL_DBZ_THRESHOLD=60
NWS_ALERTS_URL=https://api.weather.gov/alerts/active?status=actual
TROPICAL_FEED_URL=https://www.nhc.noaa.gov/CurrentStorms.json
LIGHTNING_RETENTION_MIN=15
LIGHTNING_FLUSH_S=2.0
# Push notifications need APNS/FCM credentials; leave off.
PUSH_DISABLED=1
LOG_LEVEL=INFO
