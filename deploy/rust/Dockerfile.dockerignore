# Context for deploy/rust/Dockerfile (build context = repository root).
# Keep the context small: the Rust build needs rust/, the api needs backend/basemap/styles
# and fetch-glyphs.sh. Everything else is excluded.

# Local build output and caches
**/target
**/.venv
**/__pycache__
**/*.pyc
**/node_modules
bench/work
bench/results
bench/.venv

# Large data that must never reach the daemon. Data directory names are anchored to the
# context root so Rust test fixtures under crates/*/ are not excluded.
**/*.pmtiles
backend/pmtiles-data
/data
/tiles
/grids
/state

# Version control and editor state
.git
.gitea
.github
.idea
.vscode
.DS_Store

# Python tree is not part of the Rust image (only backend/basemap is copied, by path)
backend/api
backend/base
backend/shared
backend/open_meteo_sync
temporal

# Docs and deployment manifests are not build inputs
docs
deploy/k8s
deploy/RUNBOOK.md
load
frontend
