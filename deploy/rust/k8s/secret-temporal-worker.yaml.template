# OPTIONAL. Only needed for push notifications. Replace the placeholder values and apply
# OUT-OF-BAND. Never commit real credentials.
#
# Without this Secret the worker runs and push is a no-op (PUSH_DISABLED=1 in
# temporal-worker-deployment.yaml). The secret is mounted optional, so applying it later does not
# block the pod. To enable push, in temporal-worker-deployment.yaml:
#   1. set PUSH_DISABLED to "0"
#   2. uncomment the secrets volumeMount and volume
#   3. set APNS_KEY_PATH=/secrets/apns.p8 and FCM_CREDENTIALS_PATH=/secrets/fcm.json
# Pods that are already running need a restart to see changed key files.
apiVersion: v1
kind: Secret
metadata:
  name: radar-ng-temporal-secrets
  namespace: radar-ng
  labels:
    app: radar-ng-worker
type: Opaque
stringData:
  # APNS (token-based auth). Non-secret values; the key file is the secret.
  APNS_TOPIC:   "me.vanillax.radar-ng"
  APNS_KEY_ID:  "REPLACE_ME"
  APNS_TEAM_ID: "REPLACE_ME"
  APNS_HOST:    "https://api.push.apple.com"   # api.sandbox.push.apple.com for dev

  # FCM
  FCM_PROJECT_ID: "REPLACE_ME"

  # Key files, mounted at /secrets. Replace the bodies; keep the key names.
  apns.p8: |
    -----BEGIN PRIVATE KEY-----
    REPLACE_ME (.p8 contents)
    -----END PRIVATE KEY-----
  fcm.json: |
    {
      "type": "service_account",
      "project_id": "REPLACE_ME"
    }
