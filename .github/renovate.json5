{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'America/Detroit',
  schedule: [
    '* 0-3 * * 1',
  ],
  prHourlyLimit: 3,
  prConcurrentLimit: 5,
  enabledManagers: [
    'bun',
    'github-actions',
    'cargo',
    'dockerfile',
    'docker-compose',
    'kubernetes',
    'custom.regex',
  ],
  // The kubernetes manager has no default file patterns, and temporal-dev.yml is not named like a
  // compose file, so both are listed here.
  kubernetes: {
    managerFilePatterns: [
      '/^deploy/kubernetes/.+\\.ya?ml$/',
    ],
  },
  'docker-compose': {
    managerFilePatterns: [
      '/(^|/)(docker-)?compose[^/]*\\.ya?ml$/',
      '/^deploy/temporal-dev\\.ya?ml$/',
    ],
  },
  // docker-compose.yml pins radar-ng's own images as ${RADAR_*_IMAGE:-name:tag@sha256:...}, which
  // the docker-compose manager does not read.
  customManagers: [
    {
      customType: 'regex',
      description: 'Image defaults inside ${VAR:-name:tag@digest} in the Compose file.',
      managerFilePatterns: [
        '/^deploy/docker-compose\\.yml$/',
      ],
      matchStrings: [
        '\\$\\{[A-Z_]+:-(?<depName>[^:}\\s]+):(?<currentValue>[^@}\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\}',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      description: 'GitHub Actions retain the previous monthly update cadence.',
      matchManagers: [
        'github-actions',
      ],
      schedule: [
        '* 0-3 1 * *',
      ],
    },
    {
      description: 'Major upgrades require explicit approval in the Dependency Dashboard.',
      matchUpdateTypes: [
        'major',
      ],
      groupName: null,
      groupSlug: null,
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'Group routine updates; later rules preserve compatibility sets and the monthly Actions cadence.',
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      groupName: 'weekly routine updates',
      automerge: false,
    },
    {
      description: 'Expo and React Native packages are a compatibility cohort and require explicit approval.',
      matchManagers: [
        'bun',
      ],
      matchPackageNames: [
        '/^(?:@expo\\/|expo(?:-|$)|react(?:-dom|-native(?:-|$)|$)|@react-native(?:\\/|-))/',
        '@shopify/react-native-skia',
      ],
      groupName: 'Expo and React Native compatibility set',
      dependencyDashboardApproval: true,
      automerge: false,
    },
    {
      description: 'Group routine GitHub Actions updates into one review.',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      groupName: 'GitHub Actions',
      automerge: false,
    },
    {
      description: 'Group routine container image tag and digest updates (Dockerfile, Compose, Kubernetes) into one review.',
      matchManagers: [
        'dockerfile',
        'docker-compose',
        'kubernetes',
        'custom.regex',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
      groupName: 'container images',
      automerge: false,
    },
    {
      description: 'Rust crate updates are never automerged.',
      matchManagers: [
        'cargo',
      ],
      automerge: false,
    },
    {
      description: 'Wait for new npm releases to age before proposing them.',
      matchDatasources: [
        'npm',
      ],
      minimumReleaseAge: '3 days',
    },
  ],
}
